.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.log

# Temporary files
*.tmp
*.bak
~$*

# Keep the deployed PWA and the downloadable checksum source in Git
!docs/app/
!docs/app/**
!落地/windows/dist/SHA256SUMS.txt
